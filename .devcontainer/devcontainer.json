{
    "name": "AWS Examples Codespace",
    "build": {
        "dockerfile": "Dockerfile"
    },
    "features": {
        "ghcr.io/devcontainers/features/node:1": {
            "version": "lts"
        },
        "ghcr.io/devcontainers/features/aws-cli:1": {}
    },
    "containerEnv": {
        "AWS_CLI_AUTO_PROMPT": "on-partial"
    },
    "postCreateCommand": "npm install -g aws-cdk && npm install -g typescript && cdk --version && aws --version && terraform version && sudo apt-get update && sudo apt-get install -y tree && npm --prefix s3/sdk/typescript install",
    "customizations": {
        "vscode": {
            "extensions": [
                "amazonwebservices.aws-toolkit-vscode",
                "hashicorp.terraform",
                "ms-azuretools.vscode-docker"
            ]
        }
    },
    "remoteUser": "vscode"
}